{
  "targets": [
    {
      "name": "REBEEP.COM",
      "source": "rebeep.asm",
      "format": "bin",
      "deploy": "REBEEP",
      "autoload": true
    },
    {
      "name": "REBEEPD.COM",
      "source": "rebeep.asm",
      "format": "bin",
      "deploy": "REBEEP",
      "defines": {
        "REBEEP_TRACE": 1024
      }
    },
    {
      "name": "QPICHK.COM",
      "source": "diag/qpichk.asm",
      "format": "bin",
      "deploy": "ENV"
    },
    {
      "name": "FDBOOT.BIN",
      "source": "diag/fdboot.asm",
      "format": "bin"
    },
    {
      "name": "RBTEST.COM",
      "source": "exerciser/rbtest.asm",
      "root": "tests",
      "format": "bin",
      "deploy": "REBEEP"
    },
    {
      "name": "RBSTUDIO.EXE",
      "source": "studio",
      "format": "exe",
      "deploy": "REBEEP"
    }
  ],
  "files": [
    {
      "source": "studio/data/SPLASH.ANS",
      "deploy": "REBEEP"
    },
    {
      "source": "studio/data/MENU.ANS",
      "deploy": "REBEEP"
    },
    {
      "source": "factory/patches/ORGAN.RBP",
      "deploy": "REBEEP/FACTORY/PATCHES"
    },
    {
      "source": "factory/patches/FLUTE.RBP",
      "deploy": "REBEEP/FACTORY/PATCHES"
    },
    {
      "source": "factory/patches/BRASS.RBP",
      "deploy": "REBEEP/FACTORY/PATCHES"
    },
    {
      "source": "factory/patches/BELL.RBP",
      "deploy": "REBEEP/FACTORY/PATCHES"
    }
  ]
}
