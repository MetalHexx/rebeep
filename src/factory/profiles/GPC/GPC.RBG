; ReBeep game profile: Grand Prix Circuit, the intro, the menus and the
; race, with the race's effects in patches of their own.
; It comes with ReBeep, and ReBeep's own profile is never changed. To
; change it, copy the whole folder under another one, such as
; PROFILES\USER\GPC2, and load the copy with /G:USER\GPC2.
; Each song, and the race, starts with the timer control word 43h=B6,
; then its first note. That note plays about 20 counts high, so each
; opening gets a tolerance of 40.
[PROFILE]
FORMAT=1
NAME=Grand Prix Circuit
; The bell plays until a rule picks a patch, and for any sound the
; rules don't know.
DEFAULT=FALLBK

[RULE]
; The intro song: Accolade, the title, DSI. The trophy screen too.
NAME=Intro
STEP=CTRL B6h
STEP=NOTE 1922h 40
PATCH=INTRO

[RULE]
; The menu song: game type, track, car.
NAME=Menus
STEP=CTRL B6h
STEP=NOTE 1521h 40
PATCH=MENU

[RULE]
; The race starts on the engine's idle, 24 Hz. GRID holds until the
; green light ends: the red and yellow lights share a pitch with the
; engine's revs, so they count only here.
ID=GRID
NAME=Race start
STEP=CTRL B6h
STEP=NOTE C22Eh 40
PATCH=ENGINE

[RULE]
; The rest after the green light: racing. The light starts as a note or
; as a change of the engine's, so PITCH. Off the road, 119 Hz, stays in
; the engine's patch.
ID=RACE
NAME=Racing
WHILE=GRID
STEP=PITCH 0471h 8
STEP=OFF
PATCH=ENGINE

[RULE]
; Anything else that starts this way: the fallback, logged as fallbk.
NAME=Other sounds
STEP=CTRL B6h
STEP=NOTE
PATCH=FALLBK

; Each light is one tone held about 0.4 s, at the same count each time.
; The chirp and the squeal take the engine's rest slot, 20 ms in 60.

[EFFECT]
NAME=Red and yellow lights
WHILE=GRID
PITCH=11D6h 8
PATCH=LIGHTS

[EFFECT]
NAME=Green light
WHILE=GRID
PITCH=0471h 8
PATCH=LIGHTS

[EFFECT]
; 1018 to 1115 Hz in the log, gliding.
NAME=Gear chirp
WHILE=RACE
PITCH=0461h 64
PATCH=SQUEAL

[EFFECT]
; 501 Hz.
NAME=Tire squeal
WHILE=RACE
PITCH=094Ch 40
PATCH=SQUEAL

; What the studio shows and plays for each patch: its name, when it
; sounds, and the pitch of a Space preview. ReBeep ignores these.

[SOUND]
PATCH=INTRO
NAME=Intro music
DESCRIPTION=The intro and the trophy screen
PITCH=1922h

[SOUND]
PATCH=MENU
NAME=Menu music
DESCRIPTION=The menus
PITCH=1521h

[SOUND]
PATCH=ENGINE
NAME=Engine
DESCRIPTION=The whole race
PITCH=C22Eh

[SOUND]
PATCH=LIGHTS
NAME=Start lights
DESCRIPTION=The red, yellow and green lights
PITCH=11D6h

[SOUND]
PATCH=SQUEAL
NAME=Squeal
DESCRIPTION=Tire squeals and gear changes
PITCH=094Ch

[SOUND]
PATCH=FALLBK
NAME=Other sounds
DESCRIPTION=Anything the profile doesn't recognize
