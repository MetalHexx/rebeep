{
  "name": "rebeep",
  "version": "0.1.0",
  "description": "Hear PC-speaker-only DOS games through a Sound Blaster's OPL2/OPL3, plus a cross-platform 86Box dev environment to build and test it.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MetalHexx/rebeep.git"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "rebeep": "tools/rebeep.mjs"
  },
  "scripts": {
    "rebeep": "node tools/rebeep.mjs",
    "setup": "node tools/rebeep.mjs env setup",
    "build": "node tools/rebeep.mjs build run",
    "deploy": "node tools/rebeep.mjs build run --deploy",
    "test": "node tools/rebeep.mjs test run --suite tools",
    "check": "node tools/rebeep.mjs repo check"
  }
}
