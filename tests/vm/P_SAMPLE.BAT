REM VM: mirror-freedos
REM VM-TIMEOUT: 300
REM VM-FLOPPY: build/release/rebeep-{version}-floppy.img
REM VM-RESET
REM Sample probe, stage 1: install and update from the floppy, swap in the FreeDOS sample configs and
REM warm boot.
REM Stage 2 is S_SAMP2.BAT, reached through the line appended to C:\FDAUTO.BAT.
@ECHO OFF
A:
CD \
CALL INSTALL.BAT /I C:\REBEEP
IF EXIST C:\REBEEP\REBEEP.COM GOTO INSTALLED
D:
ECHO FAIL install: REBEEP.COM not in C:\REBEEP>> D:\RESULT.TXT
GOTO FINISH
:INSTALLED
ECHO PASS install>> D:\RESULT.TXT
IF EXIST C:\REBEEP\RBSTUDIO.EXE IF EXIST C:\REBEEP\FACTORY\PATCHES\ORGAN.RBP ECHO PASS install studio>> D:\RESULT.TXT
IF NOT EXIST C:\REBEEP\RBSTUDIO.EXE ECHO FAIL install: RBSTUDIO.EXE missing>> D:\RESULT.TXT
IF NOT EXIST C:\REBEEP\FACTORY\PATCHES\ORGAN.RBP ECHO FAIL install: FACTORY\PATCHES\ORGAN.RBP missing>> D:\RESULT.TXT
IF EXIST C:\REBEEP\FACTORY\PROFILES\GPC\GPC.RBG ECHO PASS install GPC>> D:\RESULT.TXT
IF NOT EXIST C:\REBEEP\FACTORY\PROFILES\GPC\GPC.RBG ECHO FAIL install: GPC.RBG missing>> D:\RESULT.TXT
IF EXIST C:\REBEEP\FACTORY\PROFILES\GPC\SQUEAL.RBP ECHO PASS install GPC patches>> D:\RESULT.TXT
IF NOT EXIST C:\REBEEP\FACTORY\PROFILES\GPC\SQUEAL.RBP ECHO FAIL install: GPC\SQUEAL.RBP missing>> D:\RESULT.TXT
REM README.TXT's copy by hand.
C:\FREEDOS\BIN\XCOPY.EXE A:\FACTORY C:\RBHAND\FACTORY\ /S > NUL
IF EXIST C:\RBHAND\FACTORY\PATCHES\BELL.RBP ECHO PASS hand copy patches>> D:\RESULT.TXT
IF NOT EXIST C:\RBHAND\FACTORY\PATCHES\BELL.RBP ECHO FAIL hand copy: no PATCHES\BELL.RBP>> D:\RESULT.TXT
IF EXIST C:\RBHAND\FACTORY\PROFILES\GPC\GPC.RBG ECHO PASS hand copy GPC>> D:\RESULT.TXT
IF NOT EXIST C:\RBHAND\FACTORY\PROFILES\GPC\GPC.RBG ECHO FAIL hand copy: no PROFILES\GPC\GPC.RBG>> D:\RESULT.TXT
DEL C:\REBEEP\RBTEST.COM
CALL INSTALL.BAT /U C:\REBEEP
IF EXIST C:\REBEEP\RBTEST.COM ECHO PASS update>> D:\RESULT.TXT
IF NOT EXIST C:\REBEEP\RBTEST.COM ECHO FAIL update: RBTEST.COM not back>> D:\RESULT.TXT
MD C:\REBEEP\PATCHES
ECHO keep> C:\REBEEP\PATCHES\KEEP.RBP
ECHO keep> C:\REBEEP\RBSTUDIO.CFG
ECHO old> C:\REBEEP\FACTORY\OLD.RBP
ECHO old> C:\REBEEP\FACTORY\PATCHES\OLD.RBP
ECHO old> C:\REBEEP\FACTORY\PROFILES\GPC\OLD.RBP
MD C:\REBEEP\PROFILES
MD C:\REBEEP\PROFILES\GPC
ECHO keep> C:\REBEEP\PROFILES\GPC\GPC.RBG
CALL INSTALL.BAT /U C:\REBEEP
IF EXIST C:\REBEEP\PATCHES\KEEP.RBP IF EXIST C:\REBEEP\RBSTUDIO.CFG ECHO PASS update keeps PATCHES and CFG>> D:\RESULT.TXT
IF NOT EXIST C:\REBEEP\PATCHES\KEEP.RBP ECHO FAIL update removed PATCHES\KEEP.RBP>> D:\RESULT.TXT
IF NOT EXIST C:\REBEEP\RBSTUDIO.CFG ECHO FAIL update removed RBSTUDIO.CFG>> D:\RESULT.TXT
IF NOT EXIST C:\REBEEP\FACTORY\PATCHES\OLD.RBP ECHO PASS update replaces FACTORY>> D:\RESULT.TXT
IF EXIST C:\REBEEP\FACTORY\PATCHES\OLD.RBP ECHO FAIL update left FACTORY\PATCHES\OLD.RBP>> D:\RESULT.TXT
REM 0.2 and earlier kept the factory patches in FACTORY itself.
IF NOT EXIST C:\REBEEP\FACTORY\OLD.RBP ECHO PASS update removes loose patches>> D:\RESULT.TXT
IF EXIST C:\REBEEP\FACTORY\OLD.RBP ECHO FAIL update left FACTORY\OLD.RBP>> D:\RESULT.TXT
IF NOT EXIST C:\REBEEP\FACTORY\PROFILES\GPC\OLD.RBP ECHO PASS update replaces GPC>> D:\RESULT.TXT
IF EXIST C:\REBEEP\FACTORY\PROFILES\GPC\OLD.RBP ECHO FAIL update left GPC\OLD.RBP>> D:\RESULT.TXT
IF NOT EXIST C:\REBEEP\FACTORY\PROFILES\GPC\GPC.RBG ECHO FAIL update lost GPC.RBG>> D:\RESULT.TXT
C:\FREEDOS\BIN\FIND.COM "keep" C:\REBEEP\PROFILES\GPC\GPC.RBG > NUL
IF NOT ERRORLEVEL 1 ECHO PASS update keeps PROFILES>> D:\RESULT.TXT
IF ERRORLEVEL 1 ECHO FAIL update removed or rewrote PROFILES\GPC\GPC.RBG>> D:\RESULT.TXT
IF EXIST C:\REBEEP\PROFILES\GPC\SQUEAL.RBP ECHO FAIL update copied into PROFILES\GPC>> D:\RESULT.TXT
CALL INSTALL.BAT /U C:\RBNONE
IF NOT EXIST C:\RBNONE\NUL ECHO PASS update needs a copy>> D:\RESULT.TXT
IF EXIST C:\RBNONE\NUL ECHO FAIL update made C:\RBNONE>> D:\RESULT.TXT
D:
COPY A:\SAMPLES\FREEDOS\FDCONFIG.SYS C:\ >NUL
COPY A:\SAMPLES\FREEDOS\FDAUTO.BAT C:\ >NUL
ECHO CALL D:\TESTS\S_SAMP2.BAT>> C:\FDAUTO.BAT
C:\FREEDOS\BIN\FDAPM.COM WARMBOOT
GOTO END
:FINISH
ECHO DONE>> D:\RESULT.TXT
C:\FREEDOS\BIN\FDAPM.COM POWEROFF
:END
