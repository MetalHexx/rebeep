REM VM: mirror-freedos
REM VM-TIMEOUT: 150
REM Patch probe: ReBeep loads a patch by name from the settings file or /P:, and falls back to the faithful voice.
@ECHO OFF
D:
CD \
IF NOT EXIST D:\REBEEP\REBEEP.COM GOTO MISSING
IF NOT EXIST D:\REBEEP\FACTORY\PATCHES\BELL.RBP GOTO MISSING
IF NOT EXIST D:\REBEEP\FACTORY\PATCHES\ORGAN.RBP GOTO MISSING
IF NOT EXIST C:\FREEDOS\BIN\FIND.COM GOTO MISSING
MD D:\PP
MD D:\PP\USER
MD D:\PP\HEXX
COPY D:\REBEEP\FACTORY\PATCHES\BELL.RBP D:\PP\USER\BELL.RBP > NUL
COPY D:\REBEEP\FACTORY\PATCHES\ORGAN.RBP D:\PP\HEXX\ORGAN.RBP > NUL
COPY D:\REBEEP\FACTORY\PATCHES\BELL.RBP D:\PP\USER\FOUR.RBP > NUL
ECHO [4OP]>> D:\PP\USER\FOUR.RBP
ECHO CONNECTION=FM-AM>> D:\PP\USER\FOUR.RBP
ECHO FEEDBACK=1>> D:\PP\USER\FOUR.RBP
ECHO OP1=15 0 13 10 31 0 3 0 0 0 1 1>> D:\PP\USER\FOUR.RBP
ECHO OP2=15 4 13 10 63 0 1 0 0 0 1 1>> D:\PP\USER\FOUR.RBP
ECHO OP3=15 0 13 10 31 0 2 0 0 0 1 1>> D:\PP\USER\FOUR.RBP
ECHO OP4=15 4 13 10 63 0 1 0 0 0 1 1>> D:\PP\USER\FOUR.RBP
ECHO [PATCH]> D:\PP\USER\BAD.RBP
ECHO FORMAT=1>> D:\PP\USER\BAD.RBP
ECHO   Patches  =  D:\PP  > D:\REBEEP\RBSTUDIO.CFG
ECHO PATCH=FLUTE>> D:\REBEEP\RBSTUDIO.CFG
ECHO PATCH=BELL>> D:\REBEEP\RBSTUDIO.CFG
C:\JEMM\JLOAD.EXE C:\JEMM\QPIEMU.DLL
D:\REBEEP\REBEEP.COM > D:\OUT.TXT
IF ERRORLEVEL 1 GOTO LOADBAD
C:\FREEDOS\BIN\FIND.COM "patch FACTORY\FLUTE" D:\OUT.TXT > NUL
IF ERRORLEVEL 1 GOTO SETBAD
ECHO PASS settings-patch>> D:\RESULT.TXT
GOTO OVERRIDE
:SETBAD
ECHO FAIL settings-patch: the load did not name FACTORY\FLUTE (PATCH= of the settings file, first one counts)>> D:\RESULT.TXT
:OVERRIDE
D:\REBEEP\REBEEP.COM /P:BELL > D:\OUT.TXT
IF ERRORLEVEL 1 GOTO OVERBAD
D:\REBEEP\REBEEP.COM /S > D:\OUT.TXT
C:\FREEDOS\BIN\FIND.COM "patch USER\BELL" D:\OUT.TXT > NUL
IF ERRORLEVEL 1 GOTO OVERBAD
ECHO PASS user-override>> D:\RESULT.TXT
GOTO EXACT
:OVERBAD
ECHO FAIL user-override: /P:BELL did not load USER\BELL>> D:\RESULT.TXT
:EXACT
D:\REBEEP\REBEEP.COM /P:FACTORY\BELL > D:\OUT.TXT
IF ERRORLEVEL 1 GOTO EXACTBAD
D:\REBEEP\REBEEP.COM /S > D:\OUT.TXT
C:\FREEDOS\BIN\FIND.COM "patch FACTORY\BELL" D:\OUT.TXT > NUL
IF ERRORLEVEL 1 GOTO EXACTBAD
ECHO PASS factory-exact>> D:\RESULT.TXT
GOTO PACK
:EXACTBAD
ECHO FAIL factory-exact: /P:FACTORY\BELL did not load FACTORY\BELL>> D:\RESULT.TXT
:PACK
D:\REBEEP\REBEEP.COM /P:HEXX\ORGAN > D:\OUT.TXT
IF ERRORLEVEL 1 GOTO PACKBAD
D:\REBEEP\REBEEP.COM /S > D:\OUT.TXT
C:\FREEDOS\BIN\FIND.COM "patch HEXX\ORGAN" D:\OUT.TXT > NUL
IF ERRORLEVEL 1 GOTO PACKBAD
ECHO PASS bank-patch>> D:\RESULT.TXT
GOTO FOUR
:PACKBAD
ECHO FAIL bank-patch: /P:HEXX\ORGAN did not load the bank patch>> D:\RESULT.TXT
:FOUR
D:\REBEEP\REBEEP.COM /P:FOUR > D:\OUT.TXT
IF ERRORLEVEL 1 GOTO FOURBAD
D:\REBEEP\REBEEP.COM /S > D:\OUT.TXT
C:\FREEDOS\BIN\FIND.COM "patch USER\FOUR" D:\OUT.TXT > NUL
IF ERRORLEVEL 1 GOTO FOURBAD
C:\FREEDOS\BIN\FIND.COM "OPL3" D:\OUT.TXT > NUL
IF ERRORLEVEL 1 GOTO FOURPASS
C:\FREEDOS\BIN\FIND.COM "(4-OP)" D:\OUT.TXT > NUL
IF ERRORLEVEL 1 GOTO FOURBAD
:FOURPASS
ECHO PASS fourop-patch>> D:\RESULT.TXT
GOTO BADFILE
:FOURBAD
ECHO FAIL fourop-patch: a patch with a 4-OP variant did not load, or an OPL3 did not mark it as 4-OP>> D:\RESULT.TXT
:BADFILE
D:\REBEEP\REBEEP.COM /P:USER\BAD > D:\OUT.TXT
IF ERRORLEVEL 1 GOTO BADFILEBAD
C:\FREEDOS\BIN\FIND.COM "Patch USER\BAD not used" D:\OUT.TXT > NUL
IF ERRORLEVEL 1 GOTO BADFILEBAD
D:\REBEEP\REBEEP.COM /S > D:\OUT.TXT
C:\FREEDOS\BIN\FIND.COM "faithful voice" D:\OUT.TXT > NUL
IF ERRORLEVEL 1 GOTO BADFILEBAD
ECHO PASS bad-file>> D:\RESULT.TXT
GOTO MISSINGNAME
:BADFILEBAD
ECHO FAIL bad-file: a bad patch file did not fall back to the faithful voice with a message>> D:\RESULT.TXT
:MISSINGNAME
D:\REBEEP\REBEEP.COM /P:HEXX\ORGAN > NUL
D:\REBEEP\REBEEP.COM /P:NOSUCH > D:\OUT.TXT
IF ERRORLEVEL 1 GOTO NONAMEBAD
C:\FREEDOS\BIN\FIND.COM "Patch NOSUCH not used" D:\OUT.TXT > NUL
IF ERRORLEVEL 1 GOTO NONAMEBAD
D:\REBEEP\REBEEP.COM /S > D:\OUT.TXT
C:\FREEDOS\BIN\FIND.COM "faithful voice" D:\OUT.TXT > NUL
IF ERRORLEVEL 1 GOTO NONAMEBAD
ECHO PASS missing-name>> D:\RESULT.TXT
GOTO DIGITS
:NONAMEBAD
ECHO FAIL missing-name: a missing name did not fall back to the faithful voice with a message>> D:\RESULT.TXT
:DIGITS
D:\REBEEP\REBEEP.COM /P:2 > NUL
IF NOT ERRORLEVEL 1 GOTO DIGITSBAD
IF ERRORLEVEL 2 GOTO DIGITSBAD
ECHO PASS digits-bad-option>> D:\RESULT.TXT
GOTO HELDNAME
:DIGITSBAD
ECHO FAIL digits-bad-option: /P:2 did not exit with 1>> D:\RESULT.TXT
:HELDNAME
D:\REBEEP\REBEEP.COM /P:BELL > NUL
IF ERRORLEVEL 1 GOTO HELDBAD
D:\REBEEP\REBEEP.COM /F > NUL
IF ERRORLEVEL 1 GOTO HELDBAD
D:\REBEEP\REBEEP.COM /S > D:\OUT.TXT
C:\FREEDOS\BIN\FIND.COM "patch USER\BELL loaded" D:\OUT.TXT > NUL
IF ERRORLEVEL 1 GOTO HELDBAD
ECHO PASS faithful-names-patch>> D:\RESULT.TXT
GOTO UNLOAD1
:HELDBAD
ECHO FAIL faithful-names-patch: /S after /P:BELL then /F did not name the loaded patch>> D:\RESULT.TXT
:UNLOAD1
D:\REBEEP\REBEEP.COM /U > NUL
IF ERRORLEVEL 1 GOTO LOADBAD
D:\REBEEP\REBEEP.COM /P:BRASS > D:\OUT.TXT
IF ERRORLEVEL 1 GOTO LOADBAD
C:\FREEDOS\BIN\FIND.COM "patch FACTORY\BRASS" D:\OUT.TXT > NUL
IF ERRORLEVEL 1 GOTO OPTWINSBAD
ECHO PASS option-beats-settings>> D:\RESULT.TXT
GOTO FAITHFUL
:OPTWINSBAD
ECHO FAIL option-beats-settings: /P:BRASS on a load did not win over PATCH=FLUTE>> D:\RESULT.TXT
:FAITHFUL
D:\REBEEP\REBEEP.COM /U > NUL
IF ERRORLEVEL 1 GOTO LOADBAD
D:\REBEEP\REBEEP.COM /F > D:\OUT.TXT
IF ERRORLEVEL 1 GOTO LOADBAD
C:\FREEDOS\BIN\FIND.COM "faithful voice" D:\OUT.TXT > NUL
IF ERRORLEVEL 1 GOTO FAITHBAD
ECHO PASS faithful-beats-settings>> D:\RESULT.TXT
GOTO BADNAME
:FAITHBAD
ECHO FAIL faithful-beats-settings: /F on a load did not win over PATCH=FLUTE>> D:\RESULT.TXT
:BADNAME
D:\REBEEP\REBEEP.COM /U > NUL
IF ERRORLEVEL 1 GOTO LOADBAD
ECHO PATCH=..\..\X> D:\REBEEP\RBSTUDIO.CFG
D:\REBEEP\REBEEP.COM > D:\OUT.TXT
IF ERRORLEVEL 1 GOTO LOADBAD
C:\FREEDOS\BIN\FIND.COM "not used" D:\OUT.TXT > NUL
IF ERRORLEVEL 1 GOTO BADNAMEBAD
C:\FREEDOS\BIN\FIND.COM "faithful voice" D:\OUT.TXT > NUL
IF ERRORLEVEL 1 GOTO BADNAMEBAD
ECHO PASS settings-bad-name>> D:\RESULT.TXT
GOTO UNLOAD2
:BADNAMEBAD
ECHO FAIL settings-bad-name: PATCH=..\..\X was not refused with a message and the faithful voice>> D:\RESULT.TXT
:UNLOAD2
D:\REBEEP\REBEEP.COM /U > NUL
IF ERRORLEVEL 1 GOTO UNLOADBAD
ECHO PASS unload>> D:\RESULT.TXT
GOTO FINISH
:UNLOADBAD
ECHO FAIL unload: exit code not 0>> D:\RESULT.TXT
GOTO FINISH
:LOADBAD
ECHO FAIL load: ReBeep did not load or unload with exit code 0>> D:\RESULT.TXT
GOTO FINISH
:MISSING
ECHO FAIL patch: REBEEP.COM, the factory patches or FIND.COM missing>> D:\RESULT.TXT
:FINISH
ECHO DONE>> D:\RESULT.TXT
C:\FREEDOS\BIN\FDAPM.COM POWEROFF
