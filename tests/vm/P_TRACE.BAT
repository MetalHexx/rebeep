REM VM: mirror-freedos
REM VM-TIMEOUT: 150
REM Trace probe: the dev-only REBEEPD records the speaker steps and OPL notes RBTEST's checks make, and REBEEPD /D writes them to RBTRACE.TXT.
@ECHO OFF
D:
CD \
IF NOT EXIST D:\REBEEP\REBEEPD.COM GOTO MISSING
IF NOT EXIST D:\REBEEP\REBEEP.COM GOTO MISSING
IF NOT EXIST D:\REBEEP\RBTEST.COM GOTO MISSING
IF NOT EXIST C:\FREEDOS\BIN\FIND.COM GOTO MISSING
IF EXIST D:\REBEEP\RBTRACE.TXT DEL D:\REBEEP\RBTRACE.TXT
D:\REBEEP\REBEEP.COM /D
IF NOT ERRORLEVEL 1 GOTO NORMALBAD
IF ERRORLEVEL 2 GOTO NORMALBAD
ECHO PASS trace-normal-refuses>> D:\RESULT.TXT
GOTO LOAD
:NORMALBAD
ECHO FAIL trace-normal-refuses: REBEEP /D did not exit with 1>> D:\RESULT.TXT
:LOAD
C:\JEMM\JLOAD.EXE C:\JEMM\QPIEMU.DLL
LH D:\REBEEP\REBEEPD.COM
IF ERRORLEVEL 1 GOTO LOADBAD
ECHO PASS trace-load>> D:\RESULT.TXT
D:\REBEEP\REBEEP.COM /S
IF NOT ERRORLEVEL 6 GOTO OTHERBAD
IF ERRORLEVEL 7 GOTO OTHERBAD
ECHO PASS trace-other-name>> D:\RESULT.TXT
GOTO CHECKS
:OTHERBAD
ECHO FAIL trace-other-name: REBEEP /S on REBEEPD did not exit with 6>> D:\RESULT.TXT
:CHECKS
D:\REBEEP\RBTEST.COM /A /R>> D:\RESULT.TXT
D:\REBEEP\REBEEPD.COM /D
IF ERRORLEVEL 1 GOTO DUMPBAD
ECHO PASS trace-dump>> D:\RESULT.TXT
IF NOT EXIST D:\REBEEP\RBTRACE.TXT GOTO NOFILE
C:\FREEDOS\BIN\FIND.COM "step61" D:\REBEEP\RBTRACE.TXT > NUL
IF ERRORLEVEL 1 GOTO NOSTEP
ECHO PASS trace-steps>> D:\RESULT.TXT
GOTO NOTES
:NOSTEP
ECHO FAIL trace-steps: no step61 record in RBTRACE.TXT>> D:\RESULT.TXT
:NOTES
C:\FREEDOS\BIN\FIND.COM "noteon" D:\REBEEP\RBTRACE.TXT > NUL
IF ERRORLEVEL 1 GOTO NONOTE
ECHO PASS trace-notes>> D:\RESULT.TXT
GOTO SHOW
:NONOTE
ECHO FAIL trace-notes: no noteon record in RBTRACE.TXT>> D:\RESULT.TXT
:SHOW
TYPE D:\REBEEP\RBTRACE.TXT>> D:\RESULT.TXT
GOTO UNLOAD
:NOFILE
ECHO FAIL trace-file: RBTRACE.TXT not written>> D:\RESULT.TXT
GOTO UNLOAD
:DUMPBAD
ECHO FAIL trace-dump: exit code not 0>> D:\RESULT.TXT
:UNLOAD
D:\REBEEP\REBEEPD.COM /U
IF ERRORLEVEL 1 GOTO UNLOADBAD
ECHO PASS trace-unload>> D:\RESULT.TXT
GOTO FINISH
:UNLOADBAD
ECHO FAIL trace-unload: exit code not 0>> D:\RESULT.TXT
GOTO FINISH
:LOADBAD
ECHO FAIL trace-load: exit code not 0>> D:\RESULT.TXT
GOTO FINISH
:MISSING
ECHO FAIL trace: REBEEPD.COM, REBEEP.COM, RBTEST.COM or FIND.COM missing>> D:\RESULT.TXT
:FINISH
ECHO DONE>> D:\RESULT.TXT
C:\FREEDOS\BIN\FDAPM.COM POWEROFF
