REM VM: mirror-freedos
REM VM-TIMEOUT: 150
REM Capture probe: RBTEST's checks against a loaded ReBeep, also at /R:0, with the traps off, after /ON resyncs, and after unload.
@ECHO OFF
D:
CD \
IF NOT EXIST D:\REBEEP\REBEEP.COM GOTO MISSING
IF NOT EXIST D:\REBEEP\RBTEST.COM GOTO MISSING
C:\JEMM\JLOAD.EXE C:\JEMM\QPIEMU.DLL
LH D:\REBEEP\REBEEP.COM
IF ERRORLEVEL 1 GOTO LOADBAD
ECHO PASS load>> D:\RESULT.TXT
D:\REBEEP\RBTEST.COM /A /R>> D:\RESULT.TXT
D:\REBEEP\REBEEP.COM /R:0
D:\REBEEP\RBTEST.COM /A /R>> D:\RESULT.TXT
D:\REBEEP\REBEEP.COM /R:1
D:\REBEEP\REBEEP.COM /OFF
IF ERRORLEVEL 1 GOTO OFFBAD
ECHO PASS off>> D:\RESULT.TXT
GOTO TRAPSOFF
:OFFBAD
ECHO FAIL off: exit code not 0>> D:\RESULT.TXT
:TRAPSOFF
D:\REBEEP\RBTEST.COM /A>> D:\RESULT.TXT
D:\REBEEP\REBEEP.COM /S
IF ERRORLEVEL 1 GOTO STATUSBAD
ECHO PASS status>> D:\RESULT.TXT
GOTO ON
:STATUSBAD
ECHO FAIL status: exit code not 0>> D:\RESULT.TXT
:ON
D:\REBEEP\REBEEP.COM /ON
IF ERRORLEVEL 1 GOTO ONBAD
ECHO PASS on>> D:\RESULT.TXT
GOTO RESYNCED
:ONBAD
ECHO FAIL on: exit code not 0>> D:\RESULT.TXT
:RESYNCED
D:\REBEEP\RBTEST.COM /A /R>> D:\RESULT.TXT
D:\REBEEP\REBEEP.COM /U
IF ERRORLEVEL 1 GOTO UNLOADBAD
ECHO PASS unload>> D:\RESULT.TXT
GOTO GONE
:UNLOADBAD
ECHO FAIL unload: exit code not 0>> D:\RESULT.TXT
:GONE
D:\REBEEP\RBTEST.COM /A>> D:\RESULT.TXT
GOTO FINISH
:LOADBAD
ECHO FAIL load: exit code not 0>> D:\RESULT.TXT
GOTO FINISH
:MISSING
ECHO FAIL capt: REBEEP.COM or RBTEST.COM missing>> D:\RESULT.TXT
:FINISH
ECHO DONE>> D:\RESULT.TXT
C:\FREEDOS\BIN\FDAPM.COM POWEROFF
