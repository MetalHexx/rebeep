REM VM: mirror-freedos
REM VM-TIMEOUT: 300
REM Profile probe: /G: at load and on a loaded copy, its rules under RBTEST, /P: ends it, the messages, REBEEPD's log,
REM the factory's GPC (a bare name) and a player's copy of it (USER\GPC), which never stands in for it.
@ECHO OFF
D:
CD \
IF NOT EXIST D:\REBEEP\REBEEP.COM GOTO MISSING
IF NOT EXIST D:\REBEEP\REBEEPD.COM GOTO MISSING
IF NOT EXIST D:\REBEEP\RBTEST.COM GOTO MISSING
IF NOT EXIST D:\REBEEP\FACTORY\PATCHES\FLUTE.RBP GOTO MISSING
IF NOT EXIST D:\REBEEP\FACTORY\PROFILES\GPC\GPC.RBG GOTO MISSING
IF NOT EXIST C:\FREEDOS\BIN\FIND.COM GOTO MISSING
IF NOT EXIST D:\REBEEP\PROFILES\NUL MD D:\REBEEP\PROFILES
IF NOT EXIST D:\REBEEP\PROFILES\USER\NUL MD D:\REBEEP\PROFILES\USER
REM A lab copy of GPC may be on D:: the cases build their own.
IF EXIST D:\REBEEP\PROFILES\USER\GPC\NUL DEL D:\REBEEP\PROFILES\USER\GPC\*.RB?
MD D:\REBEEP\PROFILES\USER\T1
MD D:\REBEEP\PROFILES\USER\T2
MD D:\REBEEP\PROFILES\USER\T3
COPY D:\REBEEP\FACTORY\PATCHES\FLUTE.RBP D:\REBEEP\PROFILES\USER\T1\FLUTE.RBP > NUL
COPY D:\REBEEP\FACTORY\PATCHES\BELL.RBP D:\REBEEP\PROFILES\USER\T1\BELL.RBP > NUL
COPY D:\REBEEP\FACTORY\PATCHES\ORGAN.RBP D:\REBEEP\PROFILES\USER\T1\ORGAN.RBP > NUL
COPY D:\REBEEP\FACTORY\PATCHES\ORGAN.RBP D:\REBEEP\PROFILES\USER\T2\ORGAN.RBP > NUL
ECHO [PROFILE]> D:\REBEEP\PROFILES\USER\T1\T1.RBG
ECHO FORMAT=1>> D:\REBEEP\PROFILES\USER\T1\T1.RBG
ECHO NAME=Probe one>> D:\REBEEP\PROFILES\USER\T1\T1.RBG
ECHO DEFAULT=FLUTE>> D:\REBEEP\PROFILES\USER\T1\T1.RBG
ECHO [RULE]>> D:\REBEEP\PROFILES\USER\T1\T1.RBG
ECHO ID=ANY>> D:\REBEEP\PROFILES\USER\T1\T1.RBG
ECHO STEP=NOTE>> D:\REBEEP\PROFILES\USER\T1\T1.RBG
ECHO PATCH=BELL>> D:\REBEEP\PROFILES\USER\T1\T1.RBG
ECHO [RULE]>> D:\REBEEP\PROFILES\USER\T1\T1.RBG
ECHO STEP=OFF>> D:\REBEEP\PROFILES\USER\T1\T1.RBG
ECHO PATCH=ORGAN>> D:\REBEEP\PROFILES\USER\T1\T1.RBG
ECHO [EFFECT]>> D:\REBEEP\PROFILES\USER\T1\T1.RBG
ECHO NAME=One kilohertz>> D:\REBEEP\PROFILES\USER\T1\T1.RBG
ECHO WHILE=ANY>> D:\REBEEP\PROFILES\USER\T1\T1.RBG
ECHO PITCH=1193 100>> D:\REBEEP\PROFILES\USER\T1\T1.RBG
ECHO PATCH=ORGAN>> D:\REBEEP\PROFILES\USER\T1\T1.RBG
ECHO [EFFECT]>> D:\REBEEP\PROFILES\USER\T1\T1.RBG
ECHO PITCH=2711>> D:\REBEEP\PROFILES\USER\T1\T1.RBG
ECHO PATCH=NOPE>> D:\REBEEP\PROFILES\USER\T1\T1.RBG
ECHO [PROFILE]> D:\REBEEP\PROFILES\USER\T2\T2.RBG
ECHO FORMAT=1>> D:\REBEEP\PROFILES\USER\T2\T2.RBG
ECHO DEFAULT=NOPE>> D:\REBEEP\PROFILES\USER\T2\T2.RBG
ECHO [RULE]>> D:\REBEEP\PROFILES\USER\T2\T2.RBG
ECHO STEP=OFF>> D:\REBEEP\PROFILES\USER\T2\T2.RBG
ECHO PATCH=ORGAN>> D:\REBEEP\PROFILES\USER\T2\T2.RBG
ECHO [PROFILE]> D:\REBEEP\PROFILES\USER\T3\T3.RBG
C:\JEMM\JLOAD.EXE C:\JEMM\QPIEMU.DLL
D:\REBEEP\REBEEP.COM /G:USER\T1 > D:\OUT.TXT
IF ERRORLEVEL 1 GOTO LOADBAD
TYPE D:\OUT.TXT>> D:\RESULT.TXT
C:\FREEDOS\BIN\FIND.COM "patch T1\FLUTE" D:\OUT.TXT > NUL
IF ERRORLEVEL 1 GOTO FRESHBAD
C:\FREEDOS\BIN\FIND.COM "Profile USER\T1 picks" D:\OUT.TXT > NUL
IF ERRORLEVEL 1 GOTO FRESHBAD
C:\FREEDOS\BIN\FIND.COM "Patch T1\NOPE not used" D:\OUT.TXT > NUL
IF ERRORLEVEL 1 GOTO FRESHBAD
ECHO PASS profile-load>> D:\RESULT.TXT
GOTO RULES
:FRESHBAD
ECHO FAIL profile-load: /G:USER\T1 did not play T1\FLUTE, with T1 on and NOPE refused>> D:\RESULT.TXT
:RULES
D:\REBEEP\RBTEST.COM /A /R>> D:\RESULT.TXT
D:\REBEEP\REBEEP.COM /S > D:\OUT.TXT
C:\FREEDOS\BIN\FIND.COM "patch T1\ORGAN" D:\OUT.TXT > NUL
IF NOT ERRORLEVEL 1 GOTO RULESOK
C:\FREEDOS\BIN\FIND.COM "patch T1\BELL" D:\OUT.TXT > NUL
IF ERRORLEVEL 1 GOTO RULESBAD
:RULESOK
ECHO PASS profile-rules-switch>> D:\RESULT.TXT
GOTO MUTED
:RULESBAD
ECHO FAIL profile-rules-switch: RBTEST's notes did not move the patch off T1\FLUTE to another of T1's>> D:\RESULT.TXT
:MUTED
D:\REBEEP\REBEEP.COM /R:0 > NUL
D:\REBEEP\RBTEST.COM /A /R>> D:\RESULT.TXT
D:\REBEEP\REBEEP.COM /R:1 > NUL
D:\REBEEP\REBEEP.COM /S > D:\OUT.TXT
C:\FREEDOS\BIN\FIND.COM "Profile USER\T1 picks" D:\OUT.TXT > NUL
IF ERRORLEVEL 1 GOTO STATBAD
ECHO PASS profile-status>> D:\RESULT.TXT
GOTO ENDS
:STATBAD
ECHO FAIL profile-status: /S did not name the profile>> D:\RESULT.TXT
:ENDS
D:\REBEEP\REBEEP.COM /P:BELL > D:\OUT.TXT
IF ERRORLEVEL 1 GOTO ENDSBAD
D:\REBEEP\REBEEP.COM /S > D:\OUT.TXT
C:\FREEDOS\BIN\FIND.COM "patch FACTORY\BELL" D:\OUT.TXT > NUL
IF ERRORLEVEL 1 GOTO ENDSBAD
C:\FREEDOS\BIN\FIND.COM "Profile USER\T1" D:\OUT.TXT > NUL
IF NOT ERRORLEVEL 1 GOTO ENDSBAD
ECHO PASS patch-ends-profile>> D:\RESULT.TXT
GOTO CHANGE
:ENDSBAD
ECHO FAIL patch-ends-profile: /P:BELL did not play FACTORY\BELL and end the profile>> D:\RESULT.TXT
:CHANGE
D:\REBEEP\REBEEP.COM /G:USER\T1 > D:\OUT.TXT
IF ERRORLEVEL 1 GOTO CHANGEBAD
D:\REBEEP\REBEEP.COM /S > D:\OUT.TXT
C:\FREEDOS\BIN\FIND.COM "patch T1\FLUTE" D:\OUT.TXT > NUL
IF ERRORLEVEL 1 GOTO CHANGEBAD
C:\FREEDOS\BIN\FIND.COM "Profile USER\T1 picks" D:\OUT.TXT > NUL
IF ERRORLEVEL 1 GOTO CHANGEBAD
ECHO PASS profile-change>> D:\RESULT.TXT
GOTO WITHP
:CHANGEBAD
ECHO FAIL profile-change: /G:USER\T1 on a loaded copy did not play T1\FLUTE with the profile on>> D:\RESULT.TXT
:WITHP
D:\REBEEP\REBEEP.COM /G:USER\T1 /P:BELL > NUL
IF NOT ERRORLEVEL 1 GOTO WITHPBAD
IF ERRORLEVEL 2 GOTO WITHPBAD
D:\REBEEP\REBEEP.COM /F /G:USER\T1 > NUL
IF NOT ERRORLEVEL 1 GOTO WITHPBAD
IF ERRORLEVEL 2 GOTO WITHPBAD
D:\REBEEP\REBEEP.COM /G:A\B\C > NUL
IF NOT ERRORLEVEL 1 GOTO WITHPBAD
IF ERRORLEVEL 2 GOTO WITHPBAD
ECHO PASS profile-bad-option>> D:\RESULT.TXT
GOTO NOSUCH
:WITHPBAD
ECHO FAIL profile-bad-option: /G: beside /P: or /F, or /G: with two folders, did not exit with 1>> D:\RESULT.TXT
:NOSUCH
D:\REBEEP\REBEEP.COM /G:NOSUCH > D:\OUT.TXT
IF ERRORLEVEL 1 GOTO NOSUCHBAD
TYPE D:\OUT.TXT>> D:\RESULT.TXT
C:\FREEDOS\BIN\FIND.COM "Profile NOSUCH not used" D:\OUT.TXT > NUL
IF ERRORLEVEL 1 GOTO NOSUCHBAD
C:\FREEDOS\BIN\FIND.COM "not found in FACTORY" D:\OUT.TXT > NUL
IF ERRORLEVEL 1 GOTO NOSUCHBAD
D:\REBEEP\REBEEP.COM /G:USER\NOPE > D:\OUT.TXT
IF ERRORLEVEL 1 GOTO NOSUCHBAD
TYPE D:\OUT.TXT>> D:\RESULT.TXT
C:\FREEDOS\BIN\FIND.COM "Profile USER\NOPE not used" D:\OUT.TXT > NUL
IF ERRORLEVEL 1 GOTO NOSUCHBAD
C:\FREEDOS\BIN\FIND.COM "not found in PROFILES" D:\OUT.TXT > NUL
IF ERRORLEVEL 1 GOTO NOSUCHBAD
D:\REBEEP\REBEEP.COM /S > D:\OUT.TXT
C:\FREEDOS\BIN\FIND.COM "Profile USER\T1 picks" D:\OUT.TXT > NUL
IF ERRORLEVEL 1 GOTO NOSUCHBAD
ECHO PASS profile-missing>> D:\RESULT.TXT
GOTO MALFORM
:NOSUCHBAD
ECHO FAIL profile-missing: /G:NOSUCH or /G:USER\NOPE was not a message that left T1 on>> D:\RESULT.TXT
:MALFORM
D:\REBEEP\REBEEP.COM /G:USER\T3 > D:\OUT.TXT
IF ERRORLEVEL 1 GOTO MALFORMBAD
TYPE D:\OUT.TXT>> D:\RESULT.TXT
C:\FREEDOS\BIN\FIND.COM "Profile USER\T3 not used:" D:\OUT.TXT > NUL
IF ERRORLEVEL 1 GOTO MALFORMBAD
C:\FREEDOS\BIN\FIND.COM "  [PROFILE] has no FORMAT." D:\OUT.TXT > NUL
IF ERRORLEVEL 1 GOTO MALFORMBAD
ECHO PASS profile-malformed>> D:\RESULT.TXT
GOTO BADPATCH
:MALFORMBAD
ECHO FAIL profile-malformed: a profile without FORMAT was not a message>> D:\RESULT.TXT
:BADPATCH
D:\REBEEP\REBEEP.COM /G:USER\T2 > D:\OUT.TXT
IF ERRORLEVEL 1 GOTO BADPATCHBAD
TYPE D:\OUT.TXT>> D:\RESULT.TXT
C:\FREEDOS\BIN\FIND.COM "Patch T2\NOPE not used" D:\OUT.TXT > NUL
IF ERRORLEVEL 1 GOTO BADPATCHBAD
D:\REBEEP\REBEEP.COM /S > D:\OUT.TXT
C:\FREEDOS\BIN\FIND.COM "faithful voice" D:\OUT.TXT > NUL
IF ERRORLEVEL 1 GOTO BADPATCHBAD
C:\FREEDOS\BIN\FIND.COM "Profile USER\T2 picks" D:\OUT.TXT > NUL
IF ERRORLEVEL 1 GOTO BADPATCHBAD
ECHO PASS profile-bad-patch>> D:\RESULT.TXT
GOTO FACT
:BADPATCHBAD
ECHO FAIL profile-bad-patch: a missing DEFAULT= patch was not a message, the faithful voice and T2 on>> D:\RESULT.TXT
:FACT
REM GPC comes with ReBeep, in FACTORY\PROFILES: a bare name is its own, whatever PROFILES holds.
D:\REBEEP\REBEEP.COM /G:GPC > D:\OUT.TXT
IF ERRORLEVEL 1 GOTO FACTBAD
TYPE D:\OUT.TXT>> D:\RESULT.TXT
C:\FREEDOS\BIN\FIND.COM "not used" D:\OUT.TXT > NUL
IF NOT ERRORLEVEL 1 GOTO FACTBAD
D:\REBEEP\REBEEP.COM /S > D:\OUT.TXT
C:\FREEDOS\BIN\FIND.COM "patch GPC\FALLBK" D:\OUT.TXT > NUL
IF ERRORLEVEL 1 GOTO FACTBAD
C:\FREEDOS\BIN\FIND.COM "Profile GPC picks" D:\OUT.TXT > NUL
IF ERRORLEVEL 1 GOTO FACTBAD
ECHO PASS profile-factory>> D:\RESULT.TXT
GOTO OWN
:FACTBAD
ECHO FAIL profile-factory: /G:GPC did not load the factory profile and its patches>> D:\RESULT.TXT
:OWN
REM A player's GPC: its DEFAULT= is BELL, and its MENU is missing. The factory's has FALLBK and a MENU.
MD D:\REBEEP\PROFILES\USER\GPC
COPY D:\REBEEP\FACTORY\PATCHES\BELL.RBP D:\REBEEP\PROFILES\USER\GPC\BELL.RBP > NUL
ECHO [PROFILE]> D:\REBEEP\PROFILES\USER\GPC\GPC.RBG
ECHO FORMAT=1>> D:\REBEEP\PROFILES\USER\GPC\GPC.RBG
ECHO DEFAULT=BELL>> D:\REBEEP\PROFILES\USER\GPC\GPC.RBG
ECHO [RULE]>> D:\REBEEP\PROFILES\USER\GPC\GPC.RBG
ECHO STEP=OFF>> D:\REBEEP\PROFILES\USER\GPC\GPC.RBG
ECHO PATCH=MENU>> D:\REBEEP\PROFILES\USER\GPC\GPC.RBG
D:\REBEEP\REBEEP.COM /G:GPC > D:\OUT.TXT
IF ERRORLEVEL 1 GOTO BAREBAD
TYPE D:\OUT.TXT>> D:\RESULT.TXT
C:\FREEDOS\BIN\FIND.COM "not used" D:\OUT.TXT > NUL
IF NOT ERRORLEVEL 1 GOTO BAREBAD
D:\REBEEP\REBEEP.COM /S > D:\OUT.TXT
C:\FREEDOS\BIN\FIND.COM "patch GPC\FALLBK" D:\OUT.TXT > NUL
IF ERRORLEVEL 1 GOTO BAREBAD
C:\FREEDOS\BIN\FIND.COM "Profile GPC picks" D:\OUT.TXT > NUL
IF ERRORLEVEL 1 GOTO BAREBAD
ECHO PASS profile-bare-is-factory>> D:\RESULT.TXT
GOTO USERCOPY
:BAREBAD
ECHO FAIL profile-bare-is-factory: /G:GPC did not load the factory's with USER\GPC there>> D:\RESULT.TXT
:USERCOPY
D:\REBEEP\REBEEP.COM /G:USER\GPC > D:\OUT.TXT
IF ERRORLEVEL 1 GOTO USERBAD
TYPE D:\OUT.TXT>> D:\RESULT.TXT
C:\FREEDOS\BIN\FIND.COM "Patch GPC\MENU not used" D:\OUT.TXT > NUL
IF ERRORLEVEL 1 GOTO USERBAD
D:\REBEEP\REBEEP.COM /S > D:\OUT.TXT
C:\FREEDOS\BIN\FIND.COM "patch GPC\BELL" D:\OUT.TXT > NUL
IF ERRORLEVEL 1 GOTO USERBAD
C:\FREEDOS\BIN\FIND.COM "Profile USER\GPC picks" D:\OUT.TXT > NUL
IF ERRORLEVEL 1 GOTO USERBAD
ECHO PASS profile-user-copy>> D:\RESULT.TXT
GOTO BADOWN
:USERBAD
ECHO FAIL profile-user-copy: /G:USER\GPC did not load the copy, or took the factory's MENU>> D:\RESULT.TXT
:BADOWN
ECHO [PROFILE]> D:\REBEEP\PROFILES\USER\GPC\GPC.RBG
D:\REBEEP\REBEEP.COM /G:USER\GPC > D:\OUT.TXT
IF ERRORLEVEL 1 GOTO BADOWNX
TYPE D:\OUT.TXT>> D:\RESULT.TXT
C:\FREEDOS\BIN\FIND.COM "Profile USER\GPC not used" D:\OUT.TXT > NUL
IF ERRORLEVEL 1 GOTO BADOWNX
ECHO PASS profile-own-invalid>> D:\RESULT.TXT
GOTO NORBG
:BADOWNX
ECHO FAIL profile-own-invalid: a copy that can't be used was not reported>> D:\RESULT.TXT
:NORBG
REM A USER\GPC folder without GPC.RBG is not found: the copy loaded above stays on, not the factory's.
DEL D:\REBEEP\PROFILES\USER\GPC\GPC.RBG
D:\REBEEP\REBEEP.COM /G:USER\GPC > D:\OUT.TXT
IF ERRORLEVEL 1 GOTO NORBGBAD
TYPE D:\OUT.TXT>> D:\RESULT.TXT
C:\FREEDOS\BIN\FIND.COM "Profile USER\GPC not used" D:\OUT.TXT > NUL
IF ERRORLEVEL 1 GOTO NORBGBAD
C:\FREEDOS\BIN\FIND.COM "not found in PROFILES" D:\OUT.TXT > NUL
IF ERRORLEVEL 1 GOTO NORBGBAD
D:\REBEEP\REBEEP.COM /S > D:\OUT.TXT
C:\FREEDOS\BIN\FIND.COM "patch GPC\BELL" D:\OUT.TXT > NUL
IF ERRORLEVEL 1 GOTO NORBGBAD
C:\FREEDOS\BIN\FIND.COM "Profile USER\GPC picks" D:\OUT.TXT > NUL
IF ERRORLEVEL 1 GOTO NORBGBAD
ECHO PASS profile-no-rbg>> D:\RESULT.TXT
GOTO DIRRBG
:NORBGBAD
ECHO FAIL profile-no-rbg: USER\GPC without GPC.RBG was not just not found, or changed the profile>> D:\RESULT.TXT
:DIRRBG
REM A GPC.RBG that is there but won't open is reported: here it is a folder.
MD D:\REBEEP\PROFILES\USER\GPC\GPC.RBG
D:\REBEEP\REBEEP.COM /G:USER\GPC > D:\OUT.TXT
IF ERRORLEVEL 1 GOTO DIRBAD
TYPE D:\OUT.TXT>> D:\RESULT.TXT
C:\FREEDOS\BIN\FIND.COM "cannot be read" D:\OUT.TXT > NUL
IF ERRORLEVEL 1 GOTO DIRBAD
ECHO PASS profile-own-unopened>> D:\RESULT.TXT
GOTO SIZE
:DIRBAD
ECHO FAIL profile-own-unopened: a GPC.RBG that won't open was not reported>> D:\RESULT.TXT
:SIZE
REM A profile may be 4096 bytes: T6 (2.5 KB) has its DEFAULT= past the 2048 a patch may be, T7 (5 KB) is too big.
MD D:\REBEEP\PROFILES\USER\T6
MD D:\REBEEP\PROFILES\USER\T7
COPY D:\REBEEP\FACTORY\PATCHES\BELL.RBP D:\REBEEP\PROFILES\USER\T6\BELL.RBP > NUL
ECHO [PROFILE]> D:\H.TMP
ECHO FORMAT=1>> D:\H.TMP
ECHO DEFAULT=BELL> D:\TAIL.TMP
ECHO PAD=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx> D:\L99.TMP
COPY /B D:\L99.TMP+D:\L99.TMP+D:\L99.TMP+D:\L99.TMP+D:\L99.TMP D:\L495.TMP > NUL
COPY /B D:\L495.TMP+D:\L495.TMP+D:\L495.TMP+D:\L495.TMP+D:\L495.TMP D:\L2475.TMP > NUL
COPY /B D:\H.TMP+D:\L2475.TMP+D:\TAIL.TMP D:\REBEEP\PROFILES\USER\T6\T6.RBG > NUL
COPY /B D:\H.TMP+D:\L2475.TMP+D:\L2475.TMP D:\REBEEP\PROFILES\USER\T7\T7.RBG > NUL
D:\REBEEP\REBEEP.COM /G:USER\T6 > D:\OUT.TXT
IF ERRORLEVEL 1 GOTO SIZEBAD
TYPE D:\OUT.TXT>> D:\RESULT.TXT
D:\REBEEP\REBEEP.COM /S > D:\OUT.TXT
C:\FREEDOS\BIN\FIND.COM "patch T6\BELL" D:\OUT.TXT > NUL
IF ERRORLEVEL 1 GOTO SIZEBAD
C:\FREEDOS\BIN\FIND.COM "Profile USER\T6 picks" D:\OUT.TXT > NUL
IF ERRORLEVEL 1 GOTO SIZEBAD
D:\REBEEP\REBEEP.COM /G:USER\T7 > D:\OUT.TXT
IF ERRORLEVEL 1 GOTO SIZEBAD
TYPE D:\OUT.TXT>> D:\RESULT.TXT
C:\FREEDOS\BIN\FIND.COM "Profile USER\T7 not used" D:\OUT.TXT > NUL
IF ERRORLEVEL 1 GOTO SIZEBAD
C:\FREEDOS\BIN\FIND.COM "the file is over 4096 bytes" D:\OUT.TXT > NUL
IF ERRORLEVEL 1 GOTO SIZEBAD
ECHO PASS profile-size-limit>> D:\RESULT.TXT
GOTO UNLOAD
:SIZEBAD
ECHO FAIL profile-size-limit: a 2.5 KB profile did not load whole, or a 5 KB one was not over 4096 bytes>> D:\RESULT.TXT
:UNLOAD
D:\REBEEP\REBEEP.COM /U > NUL
IF ERRORLEVEL 1 GOTO LOADBAD
IF EXIST D:\REBEEP\RBTRACE.TXT DEL D:\REBEEP\RBTRACE.TXT
LH D:\REBEEP\REBEEPD.COM /G:USER\T1 > NUL
IF ERRORLEVEL 1 GOTO LOADBAD
D:\REBEEP\RBTEST.COM /A > NUL
D:\REBEEP\REBEEPD.COM /D > NUL
IF ERRORLEVEL 1 GOTO TRACEBAD
C:\FREEDOS\BIN\FIND.COM " rule    " D:\REBEEP\RBTRACE.TXT > NUL
IF ERRORLEVEL 1 GOTO TRACEBAD
C:\FREEDOS\BIN\FIND.COM " fallbk " D:\REBEEP\RBTRACE.TXT > NUL
IF ERRORLEVEL 1 GOTO TRACEBAD
C:\FREEDOS\BIN\FIND.COM " effect " D:\REBEEP\RBTRACE.TXT > NUL
IF ERRORLEVEL 1 GOTO TRACEBAD
ECHO PASS profile-trace>> D:\RESULT.TXT
GOTO TRACEOFF
:TRACEBAD
ECHO FAIL profile-trace: REBEEPD /G:USER\T1 logged no rule, fallbk or effect record>> D:\RESULT.TXT
:TRACEOFF
D:\REBEEP\REBEEPD.COM /U > NUL
IF ERRORLEVEL 1 GOTO LOADBAD
ECHO PASS unload>> D:\RESULT.TXT
GOTO FINISH
:LOADBAD
ECHO FAIL load: ReBeep did not load or unload with exit code 0>> D:\RESULT.TXT
GOTO FINISH
:MISSING
ECHO FAIL profile: a program, a factory file or FIND.COM missing>> D:\RESULT.TXT
:FINISH
ECHO DONE>> D:\RESULT.TXT
C:\FREEDOS\BIN\FDAPM.COM POWEROFF
