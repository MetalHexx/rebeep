REM VM: mirror-freedos
REM VM-TIMEOUT: 300
REM Profile probe: /G: at load and on a loaded copy, its rules under RBTEST, /P: ends it, the messages, REBEEPD's log.
@ECHO OFF
D:
CD \
IF NOT EXIST D:\REBEEP\REBEEP.COM GOTO MISSING
IF NOT EXIST D:\REBEEP\REBEEPD.COM GOTO MISSING
IF NOT EXIST D:\REBEEP\RBTEST.COM GOTO MISSING
IF NOT EXIST D:\REBEEP\FACTORY\FLUTE.RBP GOTO MISSING
IF NOT EXIST C:\FREEDOS\BIN\FIND.COM GOTO MISSING
IF NOT EXIST D:\REBEEP\PROFILES\NUL MD D:\REBEEP\PROFILES
MD D:\REBEEP\PROFILES\T1
MD D:\REBEEP\PROFILES\T2
MD D:\REBEEP\PROFILES\T3
COPY D:\REBEEP\FACTORY\FLUTE.RBP D:\REBEEP\PROFILES\T1\FLUTE.RBP > NUL
COPY D:\REBEEP\FACTORY\BELL.RBP D:\REBEEP\PROFILES\T1\BELL.RBP > NUL
COPY D:\REBEEP\FACTORY\ORGAN.RBP D:\REBEEP\PROFILES\T1\ORGAN.RBP > NUL
COPY D:\REBEEP\FACTORY\ORGAN.RBP D:\REBEEP\PROFILES\T2\ORGAN.RBP > NUL
ECHO [PROFILE]> D:\REBEEP\PROFILES\T1\T1.RBG
ECHO FORMAT=1>> D:\REBEEP\PROFILES\T1\T1.RBG
ECHO NAME=Probe one>> D:\REBEEP\PROFILES\T1\T1.RBG
ECHO DEFAULT=FLUTE>> D:\REBEEP\PROFILES\T1\T1.RBG
ECHO [RULE]>> D:\REBEEP\PROFILES\T1\T1.RBG
ECHO ID=ANY>> D:\REBEEP\PROFILES\T1\T1.RBG
ECHO STEP=NOTE>> D:\REBEEP\PROFILES\T1\T1.RBG
ECHO PATCH=BELL>> D:\REBEEP\PROFILES\T1\T1.RBG
ECHO [RULE]>> D:\REBEEP\PROFILES\T1\T1.RBG
ECHO STEP=OFF>> D:\REBEEP\PROFILES\T1\T1.RBG
ECHO PATCH=ORGAN>> D:\REBEEP\PROFILES\T1\T1.RBG
ECHO [EFFECT]>> D:\REBEEP\PROFILES\T1\T1.RBG
ECHO NAME=One kilohertz>> D:\REBEEP\PROFILES\T1\T1.RBG
ECHO WHILE=ANY>> D:\REBEEP\PROFILES\T1\T1.RBG
ECHO PITCH=1193 100>> D:\REBEEP\PROFILES\T1\T1.RBG
ECHO PATCH=ORGAN>> D:\REBEEP\PROFILES\T1\T1.RBG
ECHO [EFFECT]>> D:\REBEEP\PROFILES\T1\T1.RBG
ECHO PITCH=2711>> D:\REBEEP\PROFILES\T1\T1.RBG
ECHO PATCH=NOPE>> D:\REBEEP\PROFILES\T1\T1.RBG
ECHO [PROFILE]> D:\REBEEP\PROFILES\T2\T2.RBG
ECHO FORMAT=1>> D:\REBEEP\PROFILES\T2\T2.RBG
ECHO DEFAULT=NOPE>> D:\REBEEP\PROFILES\T2\T2.RBG
ECHO [RULE]>> D:\REBEEP\PROFILES\T2\T2.RBG
ECHO STEP=OFF>> D:\REBEEP\PROFILES\T2\T2.RBG
ECHO PATCH=ORGAN>> D:\REBEEP\PROFILES\T2\T2.RBG
ECHO [PROFILE]> D:\REBEEP\PROFILES\T3\T3.RBG
C:\JEMM\JLOAD.EXE C:\JEMM\QPIEMU.DLL
D:\REBEEP\REBEEP.COM /G:T1 > D:\OUT.TXT
IF ERRORLEVEL 1 GOTO LOADBAD
TYPE D:\OUT.TXT>> D:\RESULT.TXT
C:\FREEDOS\BIN\FIND.COM "patch T1\FLUTE" D:\OUT.TXT > NUL
IF ERRORLEVEL 1 GOTO FRESHBAD
C:\FREEDOS\BIN\FIND.COM "Profile T1 picks" D:\OUT.TXT > NUL
IF ERRORLEVEL 1 GOTO FRESHBAD
C:\FREEDOS\BIN\FIND.COM "Patch T1\NOPE not used" D:\OUT.TXT > NUL
IF ERRORLEVEL 1 GOTO FRESHBAD
ECHO PASS profile-load>> D:\RESULT.TXT
GOTO RULES
:FRESHBAD
ECHO FAIL profile-load: /G:T1 did not play T1\FLUTE, with T1 on and NOPE refused>> D:\RESULT.TXT
:RULES
D:\REBEEP\RBTEST.COM /A /R>> D:\RESULT.TXT
D:\REBEEP\REBEEP.COM /S > D:\OUT.TXT
C:\FREEDOS\BIN\FIND.COM "patch T1\ORGAN" D:\OUT.TXT > NUL
IF NOT ERRORLEVEL 1 GOTO RULESOK
C:\FREEDOS\BIN\FIND.COM "patch T1\BELL" D:\OUT.TXT > NUL
IF ERRORLEVEL 1 GOTO RULESBAD
:RULESOK
ECHO PASS profile-rules-switch>> D:\RESULT.TXT
GOTO MUTED
:RULESBAD
ECHO FAIL profile-rules-switch: RBTEST's notes did not move the patch off T1\FLUTE to another of T1's>> D:\RESULT.TXT
:MUTED
D:\REBEEP\REBEEP.COM /R:0 > NUL
D:\REBEEP\RBTEST.COM /A /R>> D:\RESULT.TXT
D:\REBEEP\REBEEP.COM /R:1 > NUL
D:\REBEEP\REBEEP.COM /S > D:\OUT.TXT
C:\FREEDOS\BIN\FIND.COM "Profile T1 picks" D:\OUT.TXT > NUL
IF ERRORLEVEL 1 GOTO STATBAD
ECHO PASS profile-status>> D:\RESULT.TXT
GOTO ENDS
:STATBAD
ECHO FAIL profile-status: /S did not name the profile>> D:\RESULT.TXT
:ENDS
D:\REBEEP\REBEEP.COM /P:BELL > D:\OUT.TXT
IF ERRORLEVEL 1 GOTO ENDSBAD
D:\REBEEP\REBEEP.COM /S > D:\OUT.TXT
C:\FREEDOS\BIN\FIND.COM "patch FACTORY\BELL" D:\OUT.TXT > NUL
IF ERRORLEVEL 1 GOTO ENDSBAD
C:\FREEDOS\BIN\FIND.COM "Profile T1" D:\OUT.TXT > NUL
IF NOT ERRORLEVEL 1 GOTO ENDSBAD
ECHO PASS patch-ends-profile>> D:\RESULT.TXT
GOTO CHANGE
:ENDSBAD
ECHO FAIL patch-ends-profile: /P:BELL did not play FACTORY\BELL and end the profile>> D:\RESULT.TXT
:CHANGE
D:\REBEEP\REBEEP.COM /G:T1 > D:\OUT.TXT
IF ERRORLEVEL 1 GOTO CHANGEBAD
D:\REBEEP\REBEEP.COM /S > D:\OUT.TXT
C:\FREEDOS\BIN\FIND.COM "patch T1\FLUTE" D:\OUT.TXT > NUL
IF ERRORLEVEL 1 GOTO CHANGEBAD
C:\FREEDOS\BIN\FIND.COM "Profile T1 picks" D:\OUT.TXT > NUL
IF ERRORLEVEL 1 GOTO CHANGEBAD
ECHO PASS profile-change>> D:\RESULT.TXT
GOTO WITHP
:CHANGEBAD
ECHO FAIL profile-change: /G:T1 on a loaded copy did not play T1\FLUTE with the profile on>> D:\RESULT.TXT
:WITHP
D:\REBEEP\REBEEP.COM /G:T1 /P:BELL > NUL
IF NOT ERRORLEVEL 1 GOTO WITHPBAD
IF ERRORLEVEL 2 GOTO WITHPBAD
D:\REBEEP\REBEEP.COM /F /G:T1 > NUL
IF NOT ERRORLEVEL 1 GOTO WITHPBAD
IF ERRORLEVEL 2 GOTO WITHPBAD
D:\REBEEP\REBEEP.COM /G:T1\X > NUL
IF NOT ERRORLEVEL 1 GOTO WITHPBAD
IF ERRORLEVEL 2 GOTO WITHPBAD
ECHO PASS profile-bad-option>> D:\RESULT.TXT
GOTO NOSUCH
:WITHPBAD
ECHO FAIL profile-bad-option: /G: beside /P: or /F, or /G: with a folder, did not exit with 1>> D:\RESULT.TXT
:NOSUCH
D:\REBEEP\REBEEP.COM /G:NOSUCH > D:\OUT.TXT
IF ERRORLEVEL 1 GOTO NOSUCHBAD
TYPE D:\OUT.TXT>> D:\RESULT.TXT
C:\FREEDOS\BIN\FIND.COM "Profile NOSUCH not used" D:\OUT.TXT > NUL
IF ERRORLEVEL 1 GOTO NOSUCHBAD
D:\REBEEP\REBEEP.COM /S > D:\OUT.TXT
C:\FREEDOS\BIN\FIND.COM "Profile T1 picks" D:\OUT.TXT > NUL
IF ERRORLEVEL 1 GOTO NOSUCHBAD
ECHO PASS profile-missing>> D:\RESULT.TXT
GOTO MALFORM
:NOSUCHBAD
ECHO FAIL profile-missing: /G:NOSUCH was not a message that left T1 on>> D:\RESULT.TXT
:MALFORM
D:\REBEEP\REBEEP.COM /G:T3 > D:\OUT.TXT
IF ERRORLEVEL 1 GOTO MALFORMBAD
TYPE D:\OUT.TXT>> D:\RESULT.TXT
C:\FREEDOS\BIN\FIND.COM "Profile T3 not used" D:\OUT.TXT > NUL
IF ERRORLEVEL 1 GOTO MALFORMBAD
ECHO PASS profile-malformed>> D:\RESULT.TXT
GOTO BADPATCH
:MALFORMBAD
ECHO FAIL profile-malformed: a profile without FORMAT was not a message>> D:\RESULT.TXT
:BADPATCH
D:\REBEEP\REBEEP.COM /G:T2 > D:\OUT.TXT
IF ERRORLEVEL 1 GOTO BADPATCHBAD
TYPE D:\OUT.TXT>> D:\RESULT.TXT
C:\FREEDOS\BIN\FIND.COM "Patch T2\NOPE not used" D:\OUT.TXT > NUL
IF ERRORLEVEL 1 GOTO BADPATCHBAD
D:\REBEEP\REBEEP.COM /S > D:\OUT.TXT
C:\FREEDOS\BIN\FIND.COM "faithful voice" D:\OUT.TXT > NUL
IF ERRORLEVEL 1 GOTO BADPATCHBAD
C:\FREEDOS\BIN\FIND.COM "Profile T2 picks" D:\OUT.TXT > NUL
IF ERRORLEVEL 1 GOTO BADPATCHBAD
ECHO PASS profile-bad-patch>> D:\RESULT.TXT
GOTO UNLOAD
:BADPATCHBAD
ECHO FAIL profile-bad-patch: a missing DEFAULT= patch was not a message, the faithful voice and T2 on>> D:\RESULT.TXT
:UNLOAD
D:\REBEEP\REBEEP.COM /U > NUL
IF ERRORLEVEL 1 GOTO LOADBAD
IF EXIST D:\REBEEP\RBTRACE.TXT DEL D:\REBEEP\RBTRACE.TXT
LH D:\REBEEP\REBEEPD.COM /G:T1 > NUL
IF ERRORLEVEL 1 GOTO LOADBAD
D:\REBEEP\RBTEST.COM /A > NUL
D:\REBEEP\REBEEPD.COM /D > NUL
IF ERRORLEVEL 1 GOTO TRACEBAD
C:\FREEDOS\BIN\FIND.COM " rule    " D:\REBEEP\RBTRACE.TXT > NUL
IF ERRORLEVEL 1 GOTO TRACEBAD
C:\FREEDOS\BIN\FIND.COM " fallbk " D:\REBEEP\RBTRACE.TXT > NUL
IF ERRORLEVEL 1 GOTO TRACEBAD
C:\FREEDOS\BIN\FIND.COM " effect " D:\REBEEP\RBTRACE.TXT > NUL
IF ERRORLEVEL 1 GOTO TRACEBAD
ECHO PASS profile-trace>> D:\RESULT.TXT
GOTO TRACEOFF
:TRACEBAD
ECHO FAIL profile-trace: REBEEPD /G:T1 logged no rule, fallbk or effect record>> D:\RESULT.TXT
:TRACEOFF
D:\REBEEP\REBEEPD.COM /U > NUL
IF ERRORLEVEL 1 GOTO LOADBAD
ECHO PASS unload>> D:\RESULT.TXT
GOTO FINISH
:LOADBAD
ECHO FAIL load: ReBeep did not load or unload with exit code 0>> D:\RESULT.TXT
GOTO FINISH
:MISSING
ECHO FAIL profile: REBEEP.COM, REBEEPD.COM, RBTEST.COM, the factory patches or FIND.COM missing>> D:\RESULT.TXT
:FINISH
ECHO DONE>> D:\RESULT.TXT
C:\FREEDOS\BIN\FDAPM.COM POWEROFF
