REM VM: mirror-freedos
REM VM-TIMEOUT: 150
REM TSR probe: REBEEP.COM's options, refusals, load (high and low), change, on and off, unload, and the autoload flag.
@ECHO OFF
D:
CD \
IF NOT EXIST D:\REBEEP\REBEEP.COM GOTO MISSING
IF NOT EXIST D:\REBEEP\RBTEST.COM GOTO MISSING
D:\REBEEP\REBEEP.COM /? >NUL
IF ERRORLEVEL 1 GOTO HELPBAD
ECHO PASS help>> D:\RESULT.TXT
GOTO BADOPT
:HELPBAD
ECHO FAIL help: exit code not 0>> D:\RESULT.TXT
:BADOPT
D:\REBEEP\REBEEP.COM /Q >NUL
IF NOT ERRORLEVEL 1 GOTO BADOPTBAD
IF ERRORLEVEL 2 GOTO BADOPTBAD
ECHO PASS badopt>> D:\RESULT.TXT
GOTO NOTLOADED
:BADOPTBAD
ECHO FAIL badopt: exit code not 1>> D:\RESULT.TXT
:NOTLOADED
D:\REBEEP\REBEEP.COM /S >NUL
IF NOT ERRORLEVEL 7 GOTO NOTLOADEDBAD
IF ERRORLEVEL 8 GOTO NOTLOADEDBAD
ECHO PASS notloaded>> D:\RESULT.TXT
GOTO SAVE1
:NOTLOADEDBAD
ECHO FAIL notloaded: exit code not 7>> D:\RESULT.TXT
:SAVE1
IF EXIST D:\RBMEM.DAT DEL D:\RBMEM.DAT
D:\REBEEP\RBTEST.COM /M:SAVE>> D:\RESULT.TXT
D:\REBEEP\REBEEP.COM >NUL
IF NOT ERRORLEVEL 3 GOTO NOQPIBAD
IF ERRORLEVEL 4 GOTO NOQPIBAD
ECHO PASS noqpi>> D:\RESULT.TXT
GOTO SAME1
:NOQPIBAD
ECHO FAIL noqpi: exit code not 3>> D:\RESULT.TXT
:SAME1
D:\REBEEP\RBTEST.COM /M:SAME refused>> D:\RESULT.TXT
C:\JEMM\JLOAD.EXE C:\JEMM\QPIEMU.DLL
IF EXIST D:\RBMEM.DAT DEL D:\RBMEM.DAT
D:\REBEEP\RBTEST.COM /M:SAVE>> D:\RESULT.TXT
LH D:\REBEEP\REBEEP.COM
IF ERRORLEVEL 1 GOTO LOADBAD
ECHO PASS load>> D:\RESULT.TXT
GOTO SAME2
:LOADBAD
ECHO FAIL load: exit code not 0>> D:\RESULT.TXT
:SAME2
D:\REBEEP\RBTEST.COM /M:SAME high>> D:\RESULT.TXT
D:\REBEEP\REBEEP.COM /S
IF ERRORLEVEL 1 GOTO STATUSBAD
ECHO PASS status>> D:\RESULT.TXT
GOTO CHANGE
:STATUSBAD
ECHO FAIL status: exit code not 0>> D:\RESULT.TXT
:CHANGE
D:\REBEEP\REBEEP.COM /P:2 /V:10
IF ERRORLEVEL 1 GOTO CHANGEBAD
ECHO PASS change>> D:\RESULT.TXT
GOTO RELOAD
:CHANGEBAD
ECHO FAIL change: exit code not 0>> D:\RESULT.TXT
:RELOAD
D:\REBEEP\REBEEP.COM
IF ERRORLEVEL 1 GOTO RELOADBAD
ECHO PASS reload>> D:\RESULT.TXT
GOTO ONOFF
:RELOADBAD
ECHO FAIL reload: exit code not 0>> D:\RESULT.TXT
:ONOFF
D:\REBEEP\REBEEP.COM /OFF
IF ERRORLEVEL 1 GOTO ONOFFBAD
D:\REBEEP\REBEEP.COM /OFF
IF ERRORLEVEL 1 GOTO ONOFFBAD
D:\REBEEP\REBEEP.COM /ON
IF ERRORLEVEL 1 GOTO ONOFFBAD
D:\REBEEP\REBEEP.COM /ON
IF ERRORLEVEL 1 GOTO ONOFFBAD
ECHO PASS onoff>> D:\RESULT.TXT
GOTO UNLOAD
:ONOFFBAD
ECHO FAIL onoff: a step did not exit 0>> D:\RESULT.TXT
:UNLOAD
D:\REBEEP\REBEEP.COM /U
IF ERRORLEVEL 1 GOTO UNLOADBAD
ECHO PASS unload>> D:\RESULT.TXT
GOTO GONE
:UNLOADBAD
ECHO FAIL unload: exit code not 0>> D:\RESULT.TXT
:GONE
D:\REBEEP\REBEEP.COM /S >NUL
IF NOT ERRORLEVEL 7 GOTO GONEBAD
IF ERRORLEVEL 8 GOTO GONEBAD
ECHO PASS gone>> D:\RESULT.TXT
GOTO SAME3
:GONEBAD
ECHO FAIL gone: exit code not 7>> D:\RESULT.TXT
:SAME3
D:\REBEEP\RBTEST.COM /M:SAME unload>> D:\RESULT.TXT
D:\REBEEP\REBEEP.COM
IF ERRORLEVEL 1 GOTO LOWLOADBAD
ECHO PASS lowload>> D:\RESULT.TXT
GOTO LOWUNLOAD
:LOWLOADBAD
ECHO FAIL lowload: exit code not 0>> D:\RESULT.TXT
:LOWUNLOAD
D:\REBEEP\REBEEP.COM /U
IF ERRORLEVEL 1 GOTO LOWUNLOADBAD
ECHO PASS lowunload>> D:\RESULT.TXT
GOTO SAME4
:LOWUNLOADBAD
ECHO FAIL lowunload: exit code not 0>> D:\RESULT.TXT
:SAME4
D:\REBEEP\RBTEST.COM /M:SAME low>> D:\RESULT.TXT
LH D:\REBEEP\REBEEP.COM
IF ERRORLEVEL 1 GOTO OFFUNLOADBAD
D:\REBEEP\REBEEP.COM /OFF
IF ERRORLEVEL 1 GOTO OFFUNLOADBAD
D:\REBEEP\REBEEP.COM /U
IF ERRORLEVEL 1 GOTO OFFUNLOADBAD
ECHO PASS offunload>> D:\RESULT.TXT
GOTO AUTOFLAG
:OFFUNLOADBAD
ECHO FAIL offunload: a step did not exit 0>> D:\RESULT.TXT
:AUTOFLAG
IF EXIST D:\REBEEP\AUTOLOAD.FLG GOTO AUTOFLAGOK
ECHO FAIL autoflag: D:\REBEEP\AUTOLOAD.FLG is missing>> D:\RESULT.TXT
GOTO FINISH
:AUTOFLAGOK
ECHO PASS autoflag>> D:\RESULT.TXT
GOTO FINISH
:MISSING
ECHO FAIL tsr: REBEEP.COM or RBTEST.COM missing>> D:\RESULT.TXT
:FINISH
ECHO DONE>> D:\RESULT.TXT
C:\FREEDOS\BIN\FDAPM.COM POWEROFF
