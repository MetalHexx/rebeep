REM VM: mirror-freedos
REM VM-TIMEOUT: 150
REM Smoke probe: QPIEMU loads, QPICHK reports the QPI up, BLASTER is set.
@ECHO OFF
D:
CD \
C:\JEMM\JLOAD.EXE C:\JEMM\QPIEMU.DLL
IF NOT EXIST D:\ENV\QPICHK.COM GOTO QPIMISSING
D:\ENV\QPICHK.COM
IF ERRORLEVEL 1 GOTO QPIBAD
ECHO PASS qpi>> D:\RESULT.TXT
GOTO BLASTER
:QPIMISSING
ECHO FAIL qpi: QPICHK.COM missing>> D:\RESULT.TXT
GOTO BLASTER
:QPIBAD
ECHO FAIL qpi: QPICHK errorlevel>> D:\RESULT.TXT
:BLASTER
IF "%BLASTER%"=="" GOTO NOBLASTER
ECHO PASS blaster>> D:\RESULT.TXT
GOTO FINISH
:NOBLASTER
ECHO FAIL blaster: BLASTER is not set>> D:\RESULT.TXT
:FINISH
ECHO DONE>> D:\RESULT.TXT
C:\FREEDOS\BIN\FDAPM.COM POWEROFF
