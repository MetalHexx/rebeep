REM VM: mirror-freedos
REM VM-TIMEOUT: 150
REM Exerciser probe: RBTEST's unattended checks, its memory probe and the benchmark, without ReBeep.
@ECHO OFF
D:
CD \
C:\JEMM\JLOAD.EXE C:\JEMM\QPIEMU.DLL
IF NOT EXIST D:\REBEEP\RBTEST.COM GOTO MISSING
IF EXIST D:\RBMEM.DAT DEL D:\RBMEM.DAT
D:\REBEEP\RBTEST.COM /M:SAVE>> D:\RESULT.TXT
D:\REBEEP\RBTEST.COM /A>> D:\RESULT.TXT
D:\REBEEP\RBTEST.COM /A /R> D:\RBR.TXT
IF ERRORLEVEL 1 GOTO NEEDSRES
ECHO FAIL r-needs-resident: RBTEST /A /R passed without ReBeep>> D:\RESULT.TXT
GOTO SAME
:NEEDSRES
ECHO PASS r-needs-resident>> D:\RESULT.TXT
:SAME
D:\REBEEP\RBTEST.COM /M:SAME same>> D:\RESULT.TXT
D:\REBEEP\RBTEST.COM /B>> D:\RESULT.TXT
GOTO FINISH
:MISSING
ECHO FAIL rbtest: RBTEST.COM missing>> D:\RESULT.TXT
:FINISH
ECHO DONE>> D:\RESULT.TXT
C:\FREEDOS\BIN\FDAPM.COM POWEROFF
