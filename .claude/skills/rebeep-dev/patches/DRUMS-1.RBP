; ReBeep patch. Edit it in ReBeep Studio or by hand.
; OPn= AR DR SL RR OL KSL MULT WAVE TREM VIB SUS KSR, decimal, 1 space apart.
; SL and OL: bigger is louder. OCTAVE 4 is the game's pitch.
[PATCH]
FORMAT=1
OCTAVE=1

[2OP]
; CONNECTION: FM or AM. FEEDBACK 0..7.
CONNECTION=AM
FEEDBACK=1
OP1=9 0 3 6 51 0 0 0 0 0 1 1
OP2=6 6 5 8 58 0 1 5 1 0 1 0

[4OP]
; CONNECTION: FM-FM, AM-FM, FM-AM or AM-AM. FEEDBACK 0..7.
CONNECTION=FM-FM
FEEDBACK=0
OP1=14 4 0 5 30 0 4 2 0 0 1 1
OP2=14 2 11 9 37 0 2 0 0 1 0 0
OP3=15 2 13 15 63 0 0 0 0 0 0 0
OP4=12 9 15 6 58 0 0 0 0 0 0 0
