; ReBeep patch. Edit it in ReBeep Studio or by hand.
; OPn= AR DR SL RR OL KSL MULT WAVE TREM VIB SUS KSR, decimal, one space apart.
; SL and OL: bigger is louder. OCTAVE 4 is the game's pitch.
[PATCH]
FORMAT=1
OCTAVE=1

[2OP]
; CONNECTION: FM or AM. FEEDBACK 0..7.
CONNECTION=AM
FEEDBACK=1
OP1=9 0 3 6 51 0 0 0 0 0 1 1
OP2=6 6 5 8 58 0 1 5 1 0 1 0

[4OP]
; CONNECTION: FM-FM, AM-FM, FM-AM or AM-AM. FEEDBACK 0..7.
CONNECTION=FM-AM
FEEDBACK=5
OP1=12 11 0 13 3 0 3 0 0 0 0 1
OP2=10 2 14 1 62 0 1 0 0 1 0 1
OP3=11 5 7 4 32 2 5 5 0 0 1 1
OP4=13 8 14 12 57 2 0 0 1 0 0 0
