; ReBeep patch. Edit it in ReBeep Studio or by hand.
; OPn= AR DR SL RR OL KSL MULT WAVE TREM VIB SUS KSR, decimal, 1 space apart.
; SL and OL: bigger is louder. OCTAVE 4 is the game's pitch.
; FROG candidate for the splash jingle. Beep: a bright blip that fades by
; itself, two sines an octave apart. OPL2 and OPL3.
[PATCH]
FORMAT=1
OCTAVE=5

[2OP]
; CONNECTION: FM or AM. FEEDBACK 0..7.
CONNECTION=AM
FEEDBACK=0
OP1=15 4 9 11 50 0 2 0 0 0 0 0
OP2=15 3 11 11 60 0 1 0 0 0 0 0
