; ReBeep patch. Edit it in ReBeep Studio or by hand.
; OPn= AR DR SL RR OL KSL MULT WAVE TREM VIB SUS KSR, decimal, 1 space apart.
; SL and OL: bigger is louder. OCTAVE 4 is the game's pitch.
; FROG candidate for the splash jingle. Beep: a pure square wave, like the PC
; speaker. OPL3 (an OPL2 plays it as a rounder abs-sine).
[PATCH]
FORMAT=1
OCTAVE=5

[2OP]
; CONNECTION: FM or AM. FEEDBACK 0..7.
CONNECTION=FM
FEEDBACK=0
OP1=15 0 15 15 0 0 1 0 0 0 1 0
OP2=15 0 15 12 58 0 1 6 0 0 1 0
