; ReBeep patch. Edit it in ReBeep Studio or by hand.
; OPn= AR DR SL RR OL KSL MULT WAVE TREM VIB SUS KSR, decimal, 1 space apart.
; SL and OL: bigger is louder. OCTAVE 4 is the game's pitch.
; FROG candidate for the splash jingle. Croak (the Re): a bigger frog, two
; octaves down; a pulse-sine modulator gives clicky pulses. Play the low row.
[PATCH]
FORMAT=1
OCTAVE=2

[2OP]
; CONNECTION: FM or AM. FEEDBACK 0..7.
CONNECTION=FM
FEEDBACK=0
OP1=15 0 15 8 60 0 0 3 0 0 1 0
OP2=15 4 11 8 63 0 10 0 0 0 0 0
