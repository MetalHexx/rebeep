; ReBeep patch. Edit it in ReBeep Studio or by hand.
; OPn= AR DR SL RR OL KSL MULT WAVE TREM VIB SUS KSR, decimal, one space apart.
; SL and OL: bigger is louder. OCTAVE 4 is the game's pitch.
; FROG candidate for the splash jingle. Croak (the Re): a saw-like modulator (feedback) at the note sweeps the carrier up again and again, a ratchet. Play the low row.
[PATCH]
FORMAT=1
OCTAVE=2

[2OP]
; CONNECTION: FM or AM. FEEDBACK 0..7.
CONNECTION=FM
FEEDBACK=5
OP1=15 0 15 8 62 0 1 0 0 0 1 0
OP2=15 3 12 8 63 0 15 2 0 0 0 0
