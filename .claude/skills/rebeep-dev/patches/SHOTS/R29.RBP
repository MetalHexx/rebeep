; ReBeep patch. Edit it in ReBeep Studio or by hand.
; OPn= AR DR SL RR OL KSL MULT WAVE TREM VIB SUS KSR, decimal, 1 space apart.
; SL and OL: bigger is louder. OCTAVE 4 is the game's pitch.
[PATCH]
FORMAT=1
OCTAVE=4

[2OP]
; CONNECTION: FM or AM. FEEDBACK 0..7.
CONNECTION=AM
FEEDBACK=0
OP1=15 0 15 12 39 0 2 0 0 0 1 0
OP2=15 0 15 12 55 0 1 0 0 0 1 0

[4OP]
; CONNECTION: FM-FM, AM-FM, FM-AM or AM-AM. FEEDBACK 0..7.
CONNECTION=AM-AM
FEEDBACK=2
OP1=15 1 12 8 55 0 1 1 0 1 1 0
OP2=13 10 8 12 62 2 3 2 0 0 0 0
OP3=15 12 13 13 58 0 1 0 0 0 0 0
OP4=13 1 1 7 53 0 1 0 0 1 0 0
