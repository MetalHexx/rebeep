; ReBeep patch. Edit it in ReBeep Studio or by hand.
; OPn= AR DR SL RR OL KSL MULT WAVE TREM VIB SUS KSR, decimal.
; SL and OL: bigger is louder. OCTAVE 4 is the game's pitch.
; The tire squeal and the gear chirp: screechy but soft. A sine carrier,
; a modulator 7 times up with vibrato, and some feedback, kept down.
[PATCH]
FORMAT=1
OCTAVE=4

[2OP]
; CONNECTION: FM or AM. FEEDBACK 0..7.
CONNECTION=FM
FEEDBACK=4
OP1=15 0 15 6 30 0 7 0 0 1 1 0
OP2=14 0 15 6 58 0 1 0 1 1 1 0
