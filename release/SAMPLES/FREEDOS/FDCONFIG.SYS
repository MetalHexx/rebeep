!COUNTRY=001,437,C:\FREEDOS\BIN\COUNTRY.SYS
!LASTDRIVE=Z
!BUFFERS=20
!FILES=40
!MENUCOLOR=7,0

MENUDEFAULT=1,5
MENU 1 - ReBeep (JEMMEX + QPIEMU)
MENU 2 - Normal (no memory manager)

1?DEVICE=C:\JEMM\JEMMEX.EXE NOEMS X=TEST NOVME NOINVLPG
1?DOS=HIGH,UMB

REM Without this SHELL line the kernel runs AUTOEXEC.BAT, not FDAUTO.BAT.
12?SHELL=C:\COMMAND.COM C:\ /E:1024 /P=C:\FDAUTO.BAT
