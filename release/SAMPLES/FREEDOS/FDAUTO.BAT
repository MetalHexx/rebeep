@ECHO OFF
SET DOSDIR=C:\FREEDOS
SET LANG=EN
REM C:\JEMM first: FreeDOS also ships an older Jemm in its BIN folder.
SET PATH=C:\JEMM;C:\REBEEP;C:\FREEDOS\BIN
SET NLSPATH=%DOSDIR%\NLS
SET HELPPATH=%DOSDIR%\HELP
SET TEMP=%DOSDIR%\TEMP
SET TMP=%TEMP%
REM Sound Blaster: port 220h, IRQ 5, DMA 1 and 5. Match your card.
SET BLASTER=A220 I5 D1 H5 T6
PROMPT $P$G
REM FreeDOS sets CONFIG to the menu number.
IF "%CONFIG%"=="1" C:\JEMM\JLOAD.EXE C:\JEMM\QPIEMU.DLL
IF "%CONFIG%"=="1" LH C:\REBEEP\REBEEP.COM
