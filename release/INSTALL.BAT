@ECHO OFF
REM Copies ReBeep to a folder and prints the lines to add. It never edits
REM CONFIG.SYS, AUTOEXEC.BAT, FDCONFIG.SYS or FDAUTO.BAT.
REM Usage: INSTALL [dir]. The default folder is C:\REBEEP.
SET DIR=C:\REBEEP
IF NOT "%1"=="" SET DIR=%1
IF NOT EXIST REBEEP.COM GOTO NOTHERE
IF NOT EXIST %DIR%\NUL MD %DIR%
IF NOT EXIST %DIR%\NUL GOTO NODIR
COPY REBEEP.COM %DIR%\
COPY RBTEST.COM %DIR%\
COPY RBPLAY.BAT %DIR%\
COPY README.TXT %DIR%\
COPY CHANGES.TXT %DIR%\
ECHO.
ECHO ReBeep is in %DIR%\
ECHO.
ECHO Add these lines to CONFIG.SYS:
ECHO   DEVICE=C:\JEMM\JEMMEX.EXE NOEMS X=TEST NOVME NOINVLPG
ECHO   DOS=HIGH,UMB
ECHO.
ECHO Add these lines to AUTOEXEC.BAT:
ECHO   PATH [your current PATH];%DIR%
ECHO   C:\JEMM\JLOAD.EXE C:\JEMM\QPIEMU.DLL
ECHO   LH REBEEP
ECHO.
ECHO Ready-made configs are in the SAMPLES folder next to INSTALL.BAT.
GOTO END
:NOTHERE
ECHO Run INSTALL from the folder that holds REBEEP.COM.
GOTO END
:NODIR
ECHO Could not create %DIR%. Nothing was copied.
:END
