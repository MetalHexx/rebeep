# slow-386sx: 386SX/16 with 4 MB, near the bottom of ReBeep's supported range.
# Runs a clone of the mirror-msdos C:. Its timing is indicative only.
# Rendered to <home>/vms/slow-386sx/86box.cfg on every `rebeep vm run`.
# Edit this file, not the 86Box settings dialog: GUI changes are overwritten.
# Never add uuid or cpu_override (each opens a dialog).

[General]
vid_renderer = qt_software
window_remember = 0

[Machine]
machine = awardsx
cpu_family = i386sx
cpu_speed = 16000000
cpu_use_dynarec = 0
fpu_type = none
mem_size = 4096
time_sync = local

[Video]
gfxcard = et4000ax

[Input devices]
mouse_type = none

[Sound]
sndcard = sb_vibra16s
fm_driver = nuked

[Storage controllers]
hdc_1 = ide_isa
fdc = internal

[Hard disks]
hdd_01_parameters = {{C_PARAMS}}
hdd_01_fn = {{C_IMG}}
hdd_01_ide_channel = 0:0
{{#D_IMG}}
hdd_02_parameters = {{D_PARAMS}}
hdd_02_fn = {{D_IMG}}
hdd_02_ide_channel = 0:1
{{/D_IMG}}

[Floppy and CD-ROM drives]
fdd_01_type = 35_2hd
fdd_02_type = none
{{#FDD1_FN}}
fdd_01_fn = {{FDD1_FN}}
{{/FDD1_FN}}
