@ECHO OFF
REM One-time setup of a FreeDOS C: for ReBeep, after an installer-made
REM C: (the scripted C: already has all of this). Run it from D:.
IF NOT EXIST D:\JEMM\JEMMEX.EXE GOTO NOJEMM
IF NOT EXIST C:\JEMM\NUL MD C:\JEMM
COPY D:\JEMM\JEMMEX.EXE C:\JEMM > NUL
COPY D:\JEMM\JEMM386.EXE C:\JEMM > NUL
COPY D:\JEMM\JLOAD.EXE C:\JEMM > NUL
COPY D:\JEMM\QPIEMU.DLL C:\JEMM > NUL
IF NOT EXIST C:\COMMAND.COM IF EXIST C:\FREEDOS\BIN\COMMAND.COM COPY C:\FREEDOS\BIN\COMMAND.COM C:\ > NUL
IF NOT EXIST C:\FREEDOS\TEMP\NUL MD C:\FREEDOS\TEMP
IF NOT EXIST C:\FDCONFIG.ORG IF EXIST C:\FDCONFIG.SYS COPY C:\FDCONFIG.SYS C:\FDCONFIG.ORG > NUL
IF NOT EXIST C:\FDAUTO.ORG IF EXIST C:\FDAUTO.BAT COPY C:\FDAUTO.BAT C:\FDAUTO.ORG > NUL
COPY D:\ENV\FREEDOS\FDCONFIG.SYS C:\FDCONFIG.SYS > NUL
COPY D:\ENV\FREEDOS\FDAUTO.BAT C:\FDAUTO.BAT > NUL
ECHO.
ECHO ReBeep setup is on C:. Restart and choose "ReBeep dev".
GOTO END
:NOJEMM
ECHO D:\JEMM is missing. Run "rebeep disk deploy" on the host, then restart.
:END
