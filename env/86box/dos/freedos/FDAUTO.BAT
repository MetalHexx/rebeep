@ECHO OFF
SET DOSDIR=C:\FREEDOS
SET LANG=EN
REM C:\JEMM first: FreeDOS also ships an older Jemm in its BIN folder.
SET PATH=C:\JEMM;%DOSDIR%\BIN
SET NLSPATH=%DOSDIR%\NLS
SET HELPPATH=%DOSDIR%\HELP
SET TEMP=%DOSDIR%\TEMP
SET TMP=%TEMP%
SET BLASTER=A220 I5 D1 H5 T6
PROMPT $P$G
REM The FreeDOS kernel sets CONFIG to the menu number.
SET RBDEV=
IF "%CONFIG%"=="1" SET RBDEV=1
IF EXIST D:\ENV\BOOT.BAT CALL D:\ENV\BOOT.BAT
