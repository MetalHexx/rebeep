@ECHO OFF
REM One-time setup of an MS-DOS 6.22 C: for ReBeep. Run it from D:.
REM Copies Jemm to C:\JEMM, keeps the originals as *.ORG and installs
REM the ReBeep CONFIG.SYS and AUTOEXEC.BAT.
IF NOT EXIST D:\JEMM\JEMMEX.EXE GOTO NOJEMM
IF NOT EXIST C:\JEMM\NUL MD C:\JEMM
COPY D:\JEMM\JEMMEX.EXE C:\JEMM > NUL
COPY D:\JEMM\JEMM386.EXE C:\JEMM > NUL
COPY D:\JEMM\JLOAD.EXE C:\JEMM > NUL
COPY D:\JEMM\QPIEMU.DLL C:\JEMM > NUL
IF NOT EXIST C:\CONFIG.ORG IF EXIST C:\CONFIG.SYS COPY C:\CONFIG.SYS C:\CONFIG.ORG > NUL
IF NOT EXIST C:\AUTOEXEC.ORG IF EXIST C:\AUTOEXEC.BAT COPY C:\AUTOEXEC.BAT C:\AUTOEXEC.ORG > NUL
COPY D:\ENV\MSDOS622\CONFIG.SYS C:\CONFIG.SYS > NUL
COPY D:\ENV\MSDOS622\AUTOEXEC.BAT C:\AUTOEXEC.BAT > NUL
ECHO.
ECHO ReBeep setup is on C:. Restart and choose "ReBeep dev".
GOTO END
:NOJEMM
ECHO D:\JEMM is missing. Run "rebeep disk deploy" on the host, then restart.
:END
